    {
      "parameters": {
        "jsCode": "// Ticket details come from the Flatten node (Split Out and Aggregate dropped them)\nconst flat = $('Flatten').first().json;\nconst lines = $input.first().json.lines ?? [];\n\n// SLA by priority (priority was already validated and lowercased)\nconst SLA_HOURS = { high: 4, medium: 24, low: 72 };\n\n// Small reference table, replacing the retired country API\nconst COUNTRIES = {\n  LK: { name: 'Sri Lanka', region: 'Asia' },\n  IN: { name: 'India', region: 'Asia' },\n  SG: { name: 'Singapore', region: 'Asia' },\n  AE: { name: 'United Arab Emirates', region: 'Asia' },\n  GB: { name: 'United Kingdom', region: 'Europe' },\n  DE: { name: 'Germany', region: 'Europe' },\n  US: { name: 'United States', region: 'Americas' },\n  AU: { name: 'Australia', region: 'Oceania' },\n};\nconst country = COUNTRIES[flat.country] ?? { name: null, region: null };\n\n// \"billing, urgent ,refund\" becomes [\"billing\",\"urgent\",\"refund\"]\nconst tags = String(flat.tags ?? '')\n  .split(',')\n  .map(t => t.trim())\n  .filter(Boolean);\n\nconst orderTotal =\n  Math.round(lines.reduce((sum, l) => sum + l.line_total, 0) * 100) / 100;\n\nreturn [{\n  json: {\n    ticket_id: flat.ticket_id,\n    created_at: flat.created,\n    priority: flat.priority,\n    sla_hours: SLA_HOURS[flat.priority],\n    customer: {\n      name: flat.name,\n      email: flat.email,\n      country_code: flat.country,\n      country_name: country.name,\n      region: country.region,\n    },\n    subject: flat.subject,\n    tags,\n    items: lines,\n    order_total: orderTotal,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1616,
        -288
      ],
